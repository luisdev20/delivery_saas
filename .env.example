# Panel administrativo y API (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
NEXT_PUBLIC_APP_NAME="DeliveryOS"

# Trabajo programado de retención (/api/cron/retention).
# El cron de la plataforma envía: Authorization: Bearer $CRON_SECRET
CRON_SECRET=genera-un-secreto-largo-y-aleatorio

# Avisos de eliminación por correo (opcional).
# Si no se define RESEND_API_KEY, se reutiliza la cuenta Brevo guardada
# en private_app_config (BREVO_API_KEY y SENDER_EMAIL).
RESEND_API_KEY=
RETENTION_EMAIL_FROM="DeliveryOS <no-reply@tudominio.com>"

# Tiendas B2B de demostración (apps/store_*)
SAAS_URL=https://tu-dominio.vercel.app
DELIVERY_API_KEY=clave-emitida-desde-el-panel-del-comercio
